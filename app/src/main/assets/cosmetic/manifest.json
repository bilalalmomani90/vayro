{
  "manifest_version": 2,
  "name": "VAYRO Page Cleaner",
  "version": "1.0",
  "description": "Hides empty ad slots left by blocked ad networks.",
  "browser_specific_settings": { "gecko": { "id": "cleaner@vayro.browser" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["ads.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
