{
  "manifest_version": 2,
  "name": "VAYRO Data Saver",
  "version": "1.0",
  "description": "Skips image requests in strict data-saver mode.",
  "browser_specific_settings": { "gecko": { "id": "saver@vayro.browser" } },
  "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "nativeMessaging"],
  "background": { "scripts": ["background.js"] }
}
