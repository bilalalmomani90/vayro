<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/site_title"
        android:textColor="@color/vayro_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- اسم الموقع LTR دائماً -->
    <TextView
        android:id="@+id/siteHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="viewStart"
        android:textColor="@color/vayro_secondary"
        android:textDirection="ltr"
        android:textSize="14sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchProtection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/site_protection_switch"
        android:textColor="@color/vayro_text" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchPopups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/site_popups_switch"
        android:textColor="@color/vayro_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/site_reload_note"
        android:textColor="@color/vayro_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/siteSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_home_card"
        android:padding="16dp"
        android:textColor="@color/vayro_text"
        android:textSize="13sp" />
</LinearLayout>
